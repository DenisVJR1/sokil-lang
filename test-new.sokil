print('sin:', sin(pi()/2))
print('cos:', cos(0))
print('map:', map([1,2,3], fn(x){return x*2}))
print('filter:', filter([1,2,3,4], fn(x){return x>2}))
print('reduce:', reduce([1,2,3], fn(a,b){return a+b}, 0))
print('reverse:', reverse([1,2,3]))
print('sum:', sum([1,2,3,4]))
print('slice:', slice([1,2,3,4,5], 1, 4))
print('is_num:', is_num(42))
print('is_str:', is_str('test'))
print('is_arr:', is_arr([1,2]))
print('is_bool:', is_bool(true))
print('is_nil:', is_nil(nil))
print('is_func:', is_func(fn(){}))
print('shuffle:', shuffle([1,2,3,4,5]))