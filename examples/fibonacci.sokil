// Послідовність Фібоначчі

fn fib(n) {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

print("Числа Фібоначчі:")
let i = 0
while i < 15 {
    print(fib(i))
    i = i + 1
}

// Ітеративний спосіб
fn fib_iter(n) {
    let a = 0
    let b = 1
    let i = 0
    while i < n {
        let temp = b
        b = a + b
        a = temp
        i = i + 1
    }
    return a
}

print("Ітеративний спосіб:")
print(fib_iter(10))